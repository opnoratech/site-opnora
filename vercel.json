{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/ssr"
    }
  ],
  "functions": {
    "api/ssr.js": {
      "runtime": "nodejs20.x",
      "includeFiles": "dist/server/**"
    }
  }
}

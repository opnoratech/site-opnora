# Opnora Environment Variables Example
# 
# Cole ou duplique este arquivo como '.env' na raiz do seu projeto
# e defina as chaves correspondentes para integrações locais e de build.
#
# AVISO: NUNCA commite o arquivo '.env' real para o Git!

# 1. URLs base e Endpoints de API
VITE_API_URL=https://api.opnora.dev

# 2. Integração de Envio de Email (ex: EmailJS, Web3Forms ou Formspree)
VITE_CONTACT_EMAIL_SERVICE_ID=
VITE_CONTACT_EMAIL_TEMPLATE_ID=
VITE_CONTACT_EMAIL_PUBLIC_KEY=

# 3. Integração de Mensageria / WhatsApp
VITE_WHATSAPP_PHONE_NUMBER=5585999973965
